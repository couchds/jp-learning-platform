{
  "name": "@jp-learning-platform/desktop",
  "productName": "Yomunami",
  "version": "0.6.1",
  "description": "Desktop companion for the Yomunami Japanese learning platform.",
  "author": "Yomunami",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "make": "npm run build && electron-builder",
    "rebuild:native": "electron-builder install-app-deps",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
